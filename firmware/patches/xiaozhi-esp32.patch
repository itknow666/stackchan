+uint32_t AudioService::GetPlaybackGeneration() {
+    std::lock_guard<std::mutex> lock(audio_queue_mutex_);
+    return playback_generation_;
+}
+
+uint32_t AudioService::BeginLocalPlayback(uint32_t expected_generation) {
+    std::lock_guard<std::mutex> lock(audio_queue_mutex_);
+    const uint32_t token = local_playback_.begin(playback_generation_, expected_generation,
+        IsPlaybackDrainedLocked(), service_stopped_.load(), IsAudioProcessorRunning());
+    if (!token) return 0;
+    playback_drained_notified_ = false;
+    network_prebuffer_.finish();
+    return playback_generation_;
+}
+
+bool AudioService::PushLocalPacket(std::unique_ptr<AudioStreamPacket> packet, uint32_t token) {
+    std::unique_lock<std::mutex> lock(audio_queue_mutex_);
+    // Unlike the network producer, the file producer retains one lease for its
+    // whole stream. A reset cannot accidentally authorize its next packet.
+    const auto valid = [this, token]() {
+        return local_playback_.current(playback_generation_, token, service_stopped_.load());
+    };
+    if (!valid()) return false;
+    if (!audio_queue_cv_.wait_for(lock, std::chrono::milliseconds(250), [&]() {
+        return !valid() || audio_decode_queue_.size() < MAX_DECODE_PACKETS_IN_QUEUE;
+    }) || !valid()) return false;
+    playback_drained_notified_ = false;
+    audio_decode_queue_.push_back(std::move(packet));
+    audio_queue_cv_.notify_all();
+    return true;
+}
+
+bool AudioService::IsLocalPlaybackCurrent(uint32_t token) {
+    std::lock_guard<std::mutex> lock(audio_queue_mutex_);
+    return local_playback_.current(playback_generation_, token, service_stopped_.load());
+}
+
+bool AudioService::IsLocalPlaybackDrained(uint32_t token) {
+    std::lock_guard<std::mutex> lock(audio_queue_mutex_);
+    return local_playback_.current(playback_generation_, token, service_stopped_.load()) && IsPlaybackDrainedLocked();
+}
+
+void AudioService::EndLocalPlayback(uint32_t token, bool cancel) {
+    bool notify_drained = false;
+    {
+        std::lock_guard<std::mutex> lock(audio_queue_mutex_);
+        if (!local_playback_.current(playback_generation_, token, service_stopped_.load())) return;
+        local_playback_.invalidate();
+        if (cancel) {
+            ++playback_generation_;
+            std::lock_guard<std::mutex> decoder_lock(decoder_mutex_);
+            if (opus_decoder_ != nullptr) esp_opus_dec_reset(opus_decoder_);
+            timestamp_queue_.clear();
+            audio_decode_queue_.clear();
+            audio_playback_queue_.clear();
+        }
+        notify_drained = MarkPlaybackDrainedLocked();
+        audio_queue_cv_.notify_all();
+    }
+    if (notify_drained && callbacks_.on_playback_drained) callbacks_.on_playback_drained();
+}
+
 bool AudioService::IsIdle() {
     std::lock_guard<std::mutex> lock(audio_queue_mutex_);
-    return audio_encode_queue_.empty() && IsPlaybackDrainedLocked() && audio_testing_queue_.empty();
+    return !local_playback_.active() && audio_encode_queue_.empty() && IsPlaybackDrainedLocked() && audio_testing_queue_.empty();
 }
 
 bool AudioService::IsPlaybackIdle() {
     std::lock_guard<std::mutex> lock(audio_queue_mutex_);
-    return IsPlaybackDrainedLocked();
+    return !local_playback_.active() && IsPlaybackDrainedLocked();
+}
+
+void AudioService::StartNetworkPlayback() {
+    std::lock_guard<std::mutex> lock(audio_queue_mutex_);
+    if (local_playback_.active()) {
+        ++playback_generation_;
+        local_playback_.invalidate();
+        audio_decode_queue_.clear();
+        audio_playback_queue_.clear();
+    }
+    network_prebuffer_.begin();
+    audio_queue_cv_.notify_all();
+}
+
+void AudioService::FinishNetworkPlayback() {
+    std::lock_guard<std::mutex> lock(audio_queue_mutex_);
+    network_prebuffer_.finish();
+    audio_queue_cv_.notify_all();
 }
 
